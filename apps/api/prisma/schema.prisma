// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id         String   @id @default(uuid())
  name       String
  address    String
  created_at DateTime @default(now())
  users      User[]
  meal_plans MealPlan[]

}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  school_id String?
  created_at DateTime @default(now())
  role Role?
  school  School?  @relation(fields: [school_id], references: [id])

  logs Log[]
  // meal_plans MealPlan[] 
  senders MealPlan[] @relation("senders")
  receivers MealPlan[] @relation("receivers")

}

enum Role {
  KITCHEN_STAFF
  WAREHOUSE_MANAGER
  SCHOOL_ADMIN
  VENDOR_MANAGER
  AUDITOR
}

model Unit {
  id        String   @id @default(uuid())
  name      String?
  created_at DateTime @default(now())
  ingredients Ingredient[]
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String
  minimum   Int
  stock   Int
  unit_id String
  created_at DateTime @default(now())
  unit Unit @relation(fields: [unit_id], references: [id])
  ingredient_recipes IngredientRecipe[]
  ingredient_transactions IngredientTransaction[] 
}

model Recipe {
  id        String   @id @default(uuid())
  name      String
  instruction String
  created_at DateTime @default(now())
  ingredientRecipes IngredientRecipe[]
  mealPlans MealPlan[]
}

model IngredientRecipe {
  id                String @id @default(uuid())
  ingredient_id     String
  recipe_id         String
  created_at        DateTime @default(now())
  quantity          Int
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])
  recipe Recipe @relation(fields: [recipe_id], references: [id])
}

model IngredientTransaction {
  id String @id @default(uuid())
  out Int 
  in Int
  current_stock Int
  created_at DateTime @default(now())
  ingredient_id String
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])
}

model Log {
  id String @id @default(uuid())
  new_data Json
  old_data Json

  user_id String
  user User @relation(fields: [user_id], references: [id])
}

model MealPlan {
  id String @id @default(uuid())
  date DateTime
  received_time DateTime
  status Status
  portion Int

  receipt_photo String?
  
  created_at DateTime @default(now())
  
  school_id String
  school School @relation(fields: [school_id], references: [id])
  
  recipe_id String
  recipe Recipe @relation(fields: [recipe_id], references: [id])

  receiver_id String?
  receiver User? @relation("receivers", fields: [receiver_id], references: [id])
 
  sender_id String
  sender User @relation("senders", fields: [sender_id], references: [id])
}

enum Status {
  RECEIVED
  SEND
  PENDING
}