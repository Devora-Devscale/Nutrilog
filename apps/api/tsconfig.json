{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,

		"types": ["node"],
		"outDir": "./dist",

		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",

		"sourceMap": true,
		"declaration": true,
		"declarationMap": true
	},
	"exclude": ["node_modules", "dist"]
}
